# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# LLM Model Selection (default: claude-opus-4-6)
LLM_MODEL=claude-opus-4-6

# OctoPrint Integration
OCTOPRINT_HOST=localhost
OCTOPRINT_PORT=5000
OCTOPRINT_API_KEY=your_octoprint_api_key_here

# Logging Configuration (default: INFO)
LOG_LEVEL=INFO

# Project Output Directory (default: ./projects)
PROJECTS_DIR=./projects
