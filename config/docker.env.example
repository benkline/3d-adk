# 3D-ADK Docker Configuration Template
#
# Copy this file to .env in the project root and fill in the required values:
#   cp config/docker.env.example .env
#
# Then run the container with docker-compose:
#   docker-compose run --rm 3d-adk

# ===== REQUIRED CONFIGURATION =====

# Anthropic API Key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== LLM CONFIGURATION =====

# Claude model to use (default: claude-opus-4-6)
# Other options: claude-sonnet-4-5-20250929, claude-haiku-4-5-20251001
LLM_MODEL=claude-opus-4-6

# ===== DOCKER-SPECIFIC PATHS =====
# These are pre-configured for Docker; only change if using custom volume mounts

# OpenSCAD binary path (Linux container)
OPENSCAD_PATH=/usr/bin/openscad

# Project output directory (mounted as volume)
PROJECTS_DIR=/app/projects

# Session state directory (mounted as volume)
SESSIONS_DIR=/app/sessions

# ===== OCTOPRINT INTEGRATION (Optional) =====

# OctoPrint hostname or IP address
# - Leave as 'localhost' if OctoPrint is running in the same container/network
# - Set to IP address if OctoPrint is on a different machine
OCTOPRINT_HOST=localhost

# OctoPrint API port (default: 5000)
OCTOPRINT_PORT=5000

# OctoPrint API key (generate in OctoPrint settings → API)
# Leave empty if not using Monitor phase
OCTOPRINT_API_KEY=

# ===== LOGGING CONFIGURATION =====

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ===== PRINTING PARAMETERS =====

# Filament cost per kilogram (USD) - used for cost estimation
FILAMENT_COST_PER_KG=25.0

# Filament consumption rate (grams/hour) - used for print time estimation
FILAMENT_G_PER_HOUR=8.0

# ===== PERFORMANCE TUNING =====
# Enable caching for repeated operations (recommended: enabled for production)

# Cache sketches based on design brief hash
SKETCH_PROMPT_CACHE_ENABLED=true

# Cache image generation prompts per perspective
IMAGE_PROMPT_CACHE_ENABLED=true

# Cache OpenSCAD compilation output
OPENSCAD_OUTPUT_CACHE_ENABLED=true

# OctoPrint polling interval in seconds (minimum 5 seconds)
OCTOPRINT_POLL_INTERVAL_S=5

# Number of metrics to keep in memory (windowing for long prints)
METRICS_WINDOW_SIZE=500
